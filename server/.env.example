# 이 파일을 .env 로 복사해 쓰세요 (server 디렉터리에서 실행할 때 읽힘).

# SQLite DB 위치 (실행 위치 기준 상대경로)
DATABASE_URL=sqlite://data/cashbook.db?mode=rwc

# Google 로그인 (OAuth 클라이언트, 루트 README '계정과 Google 로그인'). 설정하면 로그인 + API 토큰 인증을 요구합니다.
# 외부에서 접속하려면 반드시 설정하세요. 없으면 로그인 없이 기본 계정(id 1)으로, localhost에서만 동작합니다.
# CASHBOOK_GOOGLE_CLIENT_ID=
# CASHBOOK_GOOGLE_CLIENT_SECRET=
# 사용자가 접속하는 주소 (리디렉션 URI = 이 주소 + /api/auth/google/callback)
# CASHBOOK_PUBLIC_URL=http://localhost:8000
# 이 Google 계정이 처음 로그인하면 기존 데이터(계정 id 1)를 넘겨받는다
# CASHBOOK_OWNER_EMAIL=
# 모든 카드 상품을 고칠 수 있는 계정 (쉼표 구분)
# CASHBOOK_ADMIN_EMAILS=

# "오늘" 기준 시간대
CASHBOOK_TZ=Asia/Seoul

# 반복 규칙으로 이번 달 + N개월치 예정 거래를 만듭니다.
CASHBOOK_PLAN_MONTHS=2

# React 빌드 결과물 위치 (기본: ../web/dist 또는 web/dist)
# CASHBOOK_WEB_DIR=../web/dist

# 세션 쿠키 암호화 키 파일 (ROCKET_SECRET_KEY 가 없을 때 자동 생성)
# CASHBOOK_SECRET_FILE=data/secret.key

# HTTPS 리버스 프록시 뒤에서 운영하면 1
# CASHBOOK_SECURE_COOKIE=1

# 외부 주소로 열기 (비밀번호 없이 외부 주소로 열면 서버가 시작을 거부합니다)
# ROCKET_ADDRESS=0.0.0.0
# ROCKET_PORT=8000
